#!/usr/bin/env bash
# Resolve and ensure the working-tree directory SDD uses for one plan's
# short-lived artifacts: task briefs, implementer reports, review packages,
# snapshot indexes, and the progress checkpoint. Prints the absolute path.
#
# One directory per plan (.gor-mobile/state/<plan-basename>/) so a follow-up
# plan in the same working tree can never read or overwrite another plan's
# artifacts. A stale checkpoint misread as current progress makes controllers
# skip whole task sequences — plan-scoping removes that failure structurally.
#
# A self-ignoring .gitignore at .gor-mobile/state/ keeps every plan's
# workspace out of `git status` and out of sdd-snapshot trees even when the
# repo-level excludes written by `gor-mobile init` are absent.
#
# Single source of truth for the workspace location, so task-brief,
# sdd-snapshot, and review-package cannot drift to different directories.
#
# Usage: sdd-workspace PLAN_FILE
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "usage: sdd-workspace PLAN_FILE" >&2
  exit 2
fi

plan=$1
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

slug=$(basename "$plan" .md)
[ -n "$slug" ] && [ "$slug" != "." ] && [ "$slug" != ".." ] \
  || { echo "cannot derive a workspace name from: $plan" >&2; exit 2; }

root=$(git rev-parse --show-toplevel)
base="$root/.gor-mobile/state"
dir="$base/$slug"
mkdir -p "$dir"
printf '*\n' > "$base/.gitignore"
cd "$dir" && pwd
