{
  "name": "ast-usages",
  "split": "train",
  "harness": [
    "claude",
    "codex"
  ],
  "fixture": "android-app",
  "runs": 3,
  "prompt": "Найди все места, где используется IProfileRepository",
  "max_turns": 8,
  "allowed_tools": [
    "Read",
    "Glob",
    "Grep",
    "Bash(ast-index:*)",
    "Bash(grep:*)",
    "Bash(rg:*)"
  ],
  "graders": [
    {
      "bash_uses": {
        "regex": "ast-index (usages|refs|symbol)"
      }
    },
    {
      "max_denies": {
        "n": 1
      }
    },
    {
      "final_text_matches": {
        "regex": "GetProfileUseCase"
      }
    }
  ]
}